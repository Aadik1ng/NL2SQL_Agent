# Required: https://openrouter.ai/keys (used by the LiteLLM proxy, or directly by the app without it)
OPENROUTER_API_KEY=

# LiteLLM proxy (infra/litellm/config.yaml). Generate a key: echo "sk-litellm-$(openssl rand -hex 16)"
# Started by `docker compose up -d` (root docker-compose.yml).
# Without the proxy, delete these four lines and the app talks to OpenRouter directly
# (then MODEL is an OpenRouter id, e.g. anthropic/claude-haiku-4.5).
LITELLM_MASTER_KEY=
LLM_BASE_URL=http://localhost:4000
# LLM_API_KEY: same value as LITELLM_MASTER_KEY. MODEL: proxy alias: claude-haiku, claude-sonnet,
# gpt-5-mini or gpt-5.4-mini
LLM_API_KEY=
MODEL=claude-haiku
# JUDGE_MODEL=claude-sonnet   # model for `eval.py --judge`

# Optional tracing. Leave empty to disable. For the local stack in infra/langfuse/ use:
#   LANGFUSE_PUBLIC_KEY=pk-lf-local-dev  LANGFUSE_SECRET_KEY=sk-lf-local-dev  LANGFUSE_BASE_URL=http://localhost:3300
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3300
